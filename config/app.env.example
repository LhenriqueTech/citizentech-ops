# Variáveis de ambiente entregues à aplicação (copiadas para /etc/citizentech/app.env).
# PORT, SERVER_PORT, ASPNETCORE_URLS, APP_ENV e NODE_ENV são preenchidas
# automaticamente pelo script 02 a partir de config/citizentech.conf.
#
# Coloque aqui o que a sua aplicação precisa, por exemplo:
# DATABASE_URL=postgresql://user:senha@localhost:5432/citizentech
# API_KEY=troque-me
APP_NAME=CitizenTech
LOG_LEVEL=info
