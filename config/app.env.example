# Variáveis de ambiente entregues à aplicação (copiadas para /etc/citizentech/app.env, permissão 640).
# PORT, SERVER_PORT, ASPNETCORE_URLS, APP_ENV, NODE_ENV, HOST e DATA_DIR são preenchidas
# automaticamente pelo script 02 a partir de config/citizentech.conf.
#
# Semáforo Inteligente — Central de Controle
APP_NAME=CitizenTech
CIDADE=São Paulo
NUM_CRUZAMENTOS=6
CICLO_S=90
VERDE_MIN_S=15
SIMULADOR=on
LOG_LEVEL=info
# Token exigido nos POST da API (/api/sensores e /api/emergencias).
# Troque direto na VM em /etc/citizentech/app.env (o valor já existente lá é preservado).
API_TOKEN=troque-este-token
